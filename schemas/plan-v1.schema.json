{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanV1",
  "description": "Fully compiled public plan.",
  "type": "object",
  "properties": {
    "approvalPolicies": {
      "description": "Artifact signature policies.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ApprovalPolicy"
      },
      "default": {}
    },
    "backends": {
      "description": "Encryption/provider backends.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Backend"
      },
      "default": {}
    },
    "generators": {
      "description": "Generator definitions.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Generator"
      },
      "default": {}
    },
    "groups": {
      "description": "Named sets of object `IDs`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Group"
      },
      "default": {}
    },
    "identities": {
      "description": "Public recipients and signers.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Identity"
      },
      "default": {}
    },
    "schema": {
      "description": "Must equal [`PLAN_SCHEMA`].",
      "type": "string"
    },
    "secrets": {
      "description": "Secret policy and encrypted source metadata.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Secret"
      },
      "default": {}
    },
    "targets": {
      "description": "Platform consumers.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Target"
      },
      "default": {}
    },
    "templates": {
      "description": "Runtime template definitions.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Template"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": ["schema"],
  "$defs": {
    "ActivationPhase": {
      "description": "Activation lifecycle phase.",
      "oneOf": [
        {
          "description": "Disk/installation phase.",
          "type": "string",
          "const": "partitioning"
        },
        {
          "description": "Before user creation.",
          "type": "string",
          "const": "users"
        },
        {
          "description": "General activation.",
          "type": "string",
          "const": "activation"
        },
        {
          "description": "Before service consumption.",
          "type": "string",
          "const": "services"
        }
      ]
    },
    "ApprovalPolicy": {
      "description": "N-of-M artifact signature policy.",
      "type": "object",
      "properties": {
        "signers": {
          "description": "Trusted signer `IDs`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "threshold": {
          "description": "Required distinct signer count.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["threshold", "signers"]
    },
    "Backend": {
      "description": "Backend declaration.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Backend kind.",
          "$ref": "#/$defs/BackendKind"
        },
        "options": {
          "description": "Reserved public backend options. Native age uses an empty map.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": ["kind"]
    },
    "BackendKind": {
      "description": "Supported backend kinds.",
      "oneOf": [
        {
          "description": "Standard age.",
          "type": "string",
          "const": "age"
        }
      ]
    },
    "DeliveryMode": {
      "description": "Ciphertext delivery model.",
      "oneOf": [
        {
          "description": "Target-bound cache artifacts.",
          "type": "string",
          "const": "rekeyed"
        },
        {
          "description": "Canonical ciphertext includes target recipients.",
          "type": "string",
          "const": "direct"
        }
      ]
    },
    "Generator": {
      "description": "Generator declaration.",
      "type": "object",
      "properties": {
        "arguments": {
          "description": "Literal public arguments passed directly to an external executable.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "description": "Generator dependencies.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "executable": {
          "description": "Built-in name or direct executable store path.",
          "type": "string"
        },
        "maxOutputBytes": {
          "description": "Maximum plaintext bytes accepted from each external output file.",
          "type": "integer",
          "format": "uint64",
          "default": 67108864,
          "minimum": 0
        },
        "outputs": {
          "description": "Declared outputs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "parameters": {
          "description": "Strict public generator parameters, such as a random-byte length.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "prompts": {
          "description": "Explicit prompt declarations. Prompt values never enter the public plan.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GeneratorPrompt"
          }
        },
        "runtimeInputs": {
          "description": "Nix-store package roots whose `bin` directories form the generator `PATH`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "description": "Maximum external-generator execution time in seconds.",
          "type": "integer",
          "format": "uint16",
          "default": 30,
          "maximum": 65535,
          "minimum": 0
        },
        "validation": {
          "description": "Public validation fingerprint.",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "required": ["executable", "outputs"]
    },
    "GeneratorPrompt": {
      "description": "One declared external-generator prompt.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable prompt identifier, used to bind a private response file.",
          "$ref": "#/$defs/Id"
        },
        "message": {
          "description": "Public operator-facing prompt text.",
          "type": "string"
        },
        "mode": {
          "description": "Whether interactive frontends should mask the response.",
          "$ref": "#/$defs/GeneratorPromptMode"
        },
        "multiline": {
          "description": "Whether the response may contain multiple lines.",
          "type": "boolean",
          "default": false
        },
        "persistent": {
          "description": "Whether a later persistent-prompt backend may retain the response.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": ["id", "mode", "message"]
    },
    "GeneratorPromptMode": {
      "description": "Display behavior for an external-generator prompt.",
      "oneOf": [
        {
          "description": "Input should not be echoed by an interactive frontend.",
          "type": "string",
          "const": "hidden"
        },
        {
          "description": "Input may be displayed by an interactive frontend.",
          "type": "string",
          "const": "visible"
        }
      ]
    },
    "Group": {
      "description": "Named group of `IDs`.",
      "type": "object",
      "properties": {
        "members": {
          "description": "Members of the group.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      },
      "additionalProperties": false
    },
    "Id": {
      "description": "A validated stable object identifier.",
      "type": "string"
    },
    "Identity": {
      "description": "Public recipient or signer identity.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Identity role.",
          "$ref": "#/$defs/IdentityKind"
        },
        "public": {
          "description": "Public recipient, key, or plugin reference.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["kind", "public"]
    },
    "IdentityKind": {
      "description": "Identity role.",
      "oneOf": [
        {
          "description": "Administrator encryption recipient.",
          "type": "string",
          "const": "administrator"
        },
        {
          "description": "Target encryption recipient.",
          "type": "string",
          "const": "target"
        },
        {
          "description": "Recovery encryption recipient.",
          "type": "string",
          "const": "recovery"
        },
        {
          "description": "Artifact approval verifier.",
          "type": "string",
          "const": "signer"
        },
        {
          "description": "Standard age plugin reference.",
          "type": "string",
          "const": "plugin"
        }
      ]
    },
    "Lifecycle": {
      "description": "Public lifecycle metadata.",
      "type": "object",
      "properties": {
        "classification": {
          "description": "Public classification.",
          "type": ["string", "null"]
        },
        "contact": {
          "description": "Responsible contact.",
          "type": ["string", "null"]
        },
        "createdAt": {
          "description": "ISO-8601 creation time.",
          "type": ["string", "null"]
        },
        "expiresAt": {
          "description": "ISO-8601 expiry time.",
          "type": ["string", "null"]
        },
        "incidentReference": {
          "description": "Public incident or ticket reference associated with this credential.",
          "type": ["string", "null"]
        },
        "purpose": {
          "description": "Non-secret purpose.",
          "type": ["string", "null"]
        },
        "rotateAfterDays": {
          "description": "Rotation interval in days.",
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0
        },
        "rotatedAt": {
          "description": "ISO-8601 time of the most recent application-credential rotation.",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "RuntimeSettings": {
      "description": "Runtime materialization controls.",
      "type": "object",
      "properties": {
        "group": {
          "description": "File group.",
          "type": "string"
        },
        "mode": {
          "description": "Octal mode represented as a string.",
          "type": "string"
        },
        "owner": {
          "description": "File owner.",
          "type": "string"
        },
        "reloadUnits": {
          "description": "Units reloaded after a successful switch.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "restartUnits": {
          "description": "Units restarted after a successful switch.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": ["owner", "group", "mode"]
    },
    "Secret": {
      "description": "Secret policy. It contains paths and metadata, never plaintext.",
      "type": "object",
      "properties": {
        "administrators": {
          "description": "Explicit administrator identity/group `IDs`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "approvalPolicy": {
          "description": "Approval policy `ID`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumers": {
          "description": "Explicit target/group `IDs`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "delivery": {
          "description": "Artifact delivery model.",
          "$ref": "#/$defs/DeliveryMode",
          "default": "rekeyed"
        },
        "lifecycle": {
          "description": "Lifecycle metadata.",
          "$ref": "#/$defs/Lifecycle",
          "default": {
            "classification": null,
            "contact": null,
            "createdAt": null,
            "expiresAt": null,
            "incidentReference": null,
            "purpose": null,
            "rotateAfterDays": null,
            "rotatedAt": null
          }
        },
        "phase": {
          "description": "Required activation phase.",
          "$ref": "#/$defs/ActivationPhase",
          "default": "activation"
        },
        "runtime": {
          "description": "Runtime delivery settings.",
          "$ref": "#/$defs/RuntimeSettings",
          "default": {
            "group": "root",
            "mode": "0400",
            "owner": "root",
            "reloadUnits": [],
            "restartUnits": []
          }
        },
        "source": {
          "description": "Repository-relative canonical age ciphertext path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["source"]
    },
    "Target": {
      "description": "Target platform consumer.",
      "type": "object",
      "properties": {
        "identity": {
          "description": "Recipient identity `ID`.",
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "description": "Integration type.",
          "$ref": "#/$defs/TargetKind"
        },
        "system": {
          "description": "Nix system value.",
          "type": "string"
        },
        "tags": {
          "description": "Public selector tags.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "username": {
          "description": "Optional Home Manager user.",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "required": ["kind", "system", "identity"]
    },
    "TargetKind": {
      "description": "Supported integration type.",
      "oneOf": [
        {
          "description": "`NixOS` system.",
          "type": "string",
          "const": "nixOs"
        },
        {
          "description": "nix-darwin system.",
          "type": "string",
          "const": "darwin"
        },
        {
          "description": "Standalone or integrated Home Manager profile.",
          "type": "string",
          "const": "homeManager"
        }
      ]
    },
    "Template": {
      "description": "Runtime template declaration.",
      "type": "object",
      "properties": {
        "placeholders": {
          "description": "Strict placeholder declarations keyed by placeholder name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TemplatePlaceholder"
          }
        },
        "runtime": {
          "description": "Rendered-file runtime settings.",
          "$ref": "#/$defs/RuntimeSettings",
          "default": {
            "group": "root",
            "mode": "0400",
            "owner": "root",
            "reloadUnits": [],
            "restartUnits": []
          }
        },
        "source": {
          "description": "Non-secret source path.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["source", "placeholders"]
    },
    "TemplateEncoding": {
      "description": "Supported plan-level secret-to-text transformations.",
      "oneOf": [
        {
          "description": "Require valid UTF-8 and copy without modification.",
          "type": "string",
          "const": "utf8"
        },
        {
          "description": "RFC 4648 base64 with padding.",
          "type": "string",
          "const": "base64"
        },
        {
          "description": "Lowercase hexadecimal.",
          "type": "string",
          "const": "hex"
        }
      ]
    },
    "TemplatePlaceholder": {
      "description": "One explicit template placeholder binding.",
      "type": "object",
      "properties": {
        "encoding": {
          "description": "Explicit conversion from arbitrary secret bytes to template text.",
          "$ref": "#/$defs/TemplateEncoding"
        },
        "secret": {
          "description": "Secret inserted at the placeholder.",
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": ["secret", "encoding"]
    }
  }
}
